# Copy to .env; use a dedicated expiring, IP-fenced net-admin token.
# Scope to the app and selected Mac tunnels where possible; revoke after provisioning.
# Use read-only for verification and a fresh temporary net-admin token for teardown.
# Never commit the filled file.
DOXX_TOKEN=
AWS_REGION=us-east-1
DOXX_TUNNEL_NAME=aws-test-app
# Exact hostname returned by the public servers API; choose a US-east location.
DOXX_SERVER=
# Exact existing tunnel name. Connect it on your Mac before live verification.
DEVICE_TUNNEL_NAME=
WG_PARAMETER_NAME=/doxx-test-app/wg-conf
# Must not overlap the AWS VPC. The app itself accepts only the selected Mac IP.
DOXX_ALLOWED_IPS=10.0.0.0/8,2602:f5c1:1::/48
WG_MTU=1380
# Only after checking that the regional AWS baseline route bypasses doxx:
DIRECT_BASELINE_CONFIRMED=0
